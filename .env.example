OPENAI_API_KEY=<openai-api-key>
ANTHROPIC_API_KEY=<anthropic-api-key>
GOOGLE_API_KEY=<google-api-key>
MAPBOX_API_TOKEN=<mapbox-api-key>
ARCGIS_API_KEY=<arcgis-api-key>

WRI_API_KEY=<wri-api-key>
WRI_BEARER_TOKEN=<wri-bearer-token>
DOMAINS_ALLOWLIST=<domains-allowlist>
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zeno-data-local
STREAMLIT_URL=http://localhost:8501 # URL where the Streamlit app is hosted
COOKIE_SIGNER_SECRET_KEY="secret-cookie-key-123"
NEXTJS_API_KEY=<nextjs-api-key>
DATASET_EMBEDDINGS_DB=<name-of-dataset-embeddings-db>
# Model Configuration - flash for speed
# Available options: sonnet, haiku, gemini, gemini-3-flash-preview, gemini-flash, gpt
MODEL=gemini-flash
SMALL_MODEL=gemini-flash
# Model for code execution (generate_insights). gemini-2.5-flash avoids 503 when pro is overloaded
CODING_MODEL=gemini-flash
EOAPI_BASE_URL=https://eoapi.staging.globalnaturewatch.org
ANALYTICS_BASE_URL=https://analytics.globalnaturewatch.org
# SMC_API_BASE=https://services3.arcgis.com/HESxeTbDliKKvec2/arcgis/rest/services
# RESOURCE_WATCH_AUTH_URL=https://api.resourcewatch.org/auth/user/me

# Test Database connection - for development only
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/zeno-data_test

# Optional: Logging (defaults: LOG_LEVEL=INFO, LOG_FORMAT=text, LOG_TO_FILE=true)
# STAGE=production
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# Database connection
DB_HOST=111.111.111.111
DB_USERNAME=username
DB_PASSWORD=password
DB_DATABASE=database
DB_PORT=1433
