[Unit]
Description=Zeno Frontend (Streamlit)
After=network.target zeno-api.service
Wants=zeno-api.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/project-zeno
Environment="PATH=/home/ec2-user/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ec2-user/project-zeno/.env
ExecStart=/usr/bin/env uv run streamlit run frontend/app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
